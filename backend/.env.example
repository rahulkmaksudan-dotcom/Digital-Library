# Backend Environment Variables
PORT=8080
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev-h2

# Database (For PostgreSQL / Supabase)
SPRING_DATASOURCE_URL=jdbc:postgresql://db.<PROJECT-REF>.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace-with-your-supabase-database-password

# Legacy aliases also supported by application-postgres.yml
DATABASE_URL=jdbc:postgresql://localhost:5432/digital_library
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload Directory
FILE_UPLOAD_DIR=./uploads

