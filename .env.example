# ==============================================================================
# DIGITAL LIBRARY MANAGEMENT SYSTEM - ENVIRONMENT VARIABLES TEMPLATE
# Institution: Thakur Shree DPS College of Engineering and Management
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_NAME=Digital Library Management System
VITE_INSTITUTION_NAME=Thakur Shree DPS College of Engineering and Management
VITE_APP_ENV=development

# ------------------------------------------------------------------------------
# BACKEND & DATABASE CONFIGURATION (Spring Boot)
# ------------------------------------------------------------------------------
# Server port (default 8080 locally, dynamically assigned by Render via $PORT)
PORT=8080
SERVER_PORT=8080

# Active Spring Profile: 'dev-h2' for local zero-config, or 'postgres' for PostgreSQL / Supabase
SPRING_PROFILES_ACTIVE=postgres

# Local PostgreSQL or Supabase Connection
# For Local Postgres: jdbc:postgresql://localhost:5432/digital_library
# For Supabase: jdbc:postgresql://db.<PROJECT-REF>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/digital_library
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# ------------------------------------------------------------------------------
# SECURITY & JWT CONFIGURATION
# ------------------------------------------------------------------------------
# Secret key for JWT signing (Minimum 256-bit / 32-character secure random string)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# Expiration time in milliseconds (e.g., 86400000 = 24 hours)
JWT_EXPIRATION=86400000

# Allowed CORS Origins (comma-separated for multiple origins)
# For local dev: http://localhost:5173
# For Vercel production: https://your-production-app.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# FILE STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
FILE_UPLOAD_DIR=./uploads
FILE_MAX_SIZE=10MB

# ------------------------------------------------------------------------------
# EMAIL (SMTP) NOTIFICATIONS CONFIGURATION
# ------------------------------------------------------------------------------
# (Optional locally - if unconfigured, notifications still save to database and UI)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=library@dpscollege.edu
MAIL_ENABLED=false

